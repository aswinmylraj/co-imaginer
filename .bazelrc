common --repository_cache=~/.cache/bazel/repos
common --repo_contents_cache=~/.cache/bazel/repo-contents
common --repo_contents_cache_gc_max_age=7d
common --disk_cache=~/.cache/bazel/disk
common --experimental_disk_cache_gc_max_size=25G
common --experimental_disk_cache_gc_max_age=7d
common --lockfile_mode=off
