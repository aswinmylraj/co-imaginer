module(name = "project_co_imaginer")

bazel_dep(name = "rules_shell", version = "0.8.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

TOOL_BUILD = """
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

sh_binary(
    name = "bin",
    srcs = ["{name}"],
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "gitleaks",
    build_file_content = TOOL_BUILD.format(name = "gitleaks"),
    sha256 = "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb",
    url = "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz",
)

http_archive(
    name = "ruff",
    build_file_content = TOOL_BUILD.format(name = "ruff"),
    sha256 = "3ab2b34aeacdbc1ea5c529cdbda3e05792633d587228123fd09f3b5a0facb27a",
    strip_prefix = "ruff-x86_64-unknown-linux-gnu",
    url = "https://github.com/astral-sh/ruff/releases/download/0.17.4/ruff-x86_64-unknown-linux-gnu.tar.gz",
)

http_archive(
    name = "uv",
    build_file_content = TOOL_BUILD.format(name = "uv"),
    sha256 = "c5221ff41b7892bfc223543883600125f6a47fe845093e0f5bdff4f359196d83",
    strip_prefix = "uv-x86_64-unknown-linux-gnu",
    url = "https://github.com/astral-sh/uv/releases/download/0.13.7/uv-x86_64-unknown-linux-gnu.tar.gz",
)
